# Copy these into Vercel: Project > Settings > Environment Variables.
# For running on your own computer, copy this file to .env.local and fill it in.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Your site's real address, once you have a domain. Used in email links.
NEXT_PUBLIC_SITE_URL=https://abeconclub.org

# Newsletter email (optional until you have a domain). From resend.com.
RESEND_API_KEY=re_...
NEWSLETTER_FROM_EMAIL=AB Econ <newsletter@abeconclub.org>
